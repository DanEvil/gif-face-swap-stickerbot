# --- Telegram ---
BOT_TOKEN=123456:ABC...           # токен от @BotFather
# необязательно: обход блокировок
TELEGRAM_PROXY=                   # socks5://user:pass@host:port или http://...
TELEGRAM_API_BASE_URL=            # зеркало Bot API, например https://api.example.org/bot

# --- Гейт доступа ---
REQUIRED_CHANNELS=@channel1,@channel2   # подписка обязательна; пусто = не требовать
GATEWAY_REQUIRED=1                      # требовать старт гейт-бота
GATEWAY_BOT_USERNAME=KO_Gateway_bot

# --- Права ---
ADMIN_IDS=123456789          # через запятую; админам гейт не проверяется
JOBS_CONCURRENCY=2           # сколько генераций старикеров работают одновременно

# --- Генерация ---
STICKER_SRC_DIR=stickers_src   # библиотека паков: подпапка = пак
CACHE_DIR=cache
MAX_STICKERS=10
PACK_TITLE_TEMPLATE=Faceswap {name} by {bot}
STICKER_EMOJI=😀

# --- ffmpeg (опционально) ---
FFMPEG_PATH=                   # если ffmpeg не в PATH
